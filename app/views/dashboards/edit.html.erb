<% content_for(:title) { "SeshQL — Edit #{@dashboard.name}" } %>

<div class="mb-6">
  <div class="flex items-center gap-3 mb-1">
    <%= link_to "Dashboards", dashboards_path, class: "text-sm text-gray-500 hover:text-gray-300 transition" %>
    <span class="text-gray-600">/</span>
    <%= link_to @dashboard.name, dashboard_path(@dashboard), class: "text-sm text-gray-500 hover:text-gray-300 transition" %>
    <span class="text-gray-600">/</span>
    <h1 class="text-lg font-semibold text-white">Edit</h1>
  </div>
</div>

<%= render "form", dashboard: @dashboard %>

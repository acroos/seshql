<% content_for(:title) { "SeshQL — Dashboards" } %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-lg font-semibold text-white mb-1">Dashboards</h1>
    <p class="text-sm text-gray-500">Create and save custom chart dashboards from your session data.</p>
  </div>
  <%= link_to new_dashboard_path, class: "bg-accent hover:bg-accent-dim text-white text-sm font-medium px-4 py-2 rounded-lg transition flex items-center gap-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    New Dashboard
  <% end %>
</div>

<% if @dashboards.any? %>
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @dashboards.each do |dashboard| %>
      <%= link_to dashboard_path(dashboard), class: "bg-surface-raised border border-border rounded-xl p-5 hover:border-accent/50 transition group" do %>
        <div class="flex items-start justify-between mb-3">
          <div>
            <h2 class="text-sm font-medium text-gray-200 group-hover:text-white transition"><%= dashboard.name %></h2>
            <% if dashboard.description.present? %>
              <p class="text-xs text-gray-500 mt-1 line-clamp-2"><%= dashboard.description %></p>
            <% end %>
          </div>
          <svg class="w-5 h-5 text-gray-600 group-hover:text-accent transition" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
          </svg>
        </div>
        <div class="flex items-center gap-3 text-xs text-gray-600">
          <span><%= dashboard.panels.count %> panel<%= dashboard.panels.count == 1 ? '' : 's' %></span>
          <span>Updated <%= time_ago_short(dashboard.updated_at) %></span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-surface-raised border border-border rounded-xl p-12 text-center">
    <svg class="w-12 h-12 text-gray-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
    </svg>
    <p class="text-gray-400 mb-2">No dashboards yet</p>
    <p class="text-sm text-gray-600 mb-4">Create your first dashboard to track query values over time.</p>
    <%= link_to "Create Dashboard", new_dashboard_path, class: "inline-block bg-accent hover:bg-accent-dim text-white text-sm font-medium px-4 py-2 rounded-lg transition" %>
  </div>
<% end %>

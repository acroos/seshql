<% content_for(:title) { "SeshQL — Dashboard" } %>

<!-- Stats cards -->
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-8">
  <%= render partial: "stat_card", locals: { label: "Sessions", value: @total_sessions, icon: "chat" } %>
  <%= render partial: "stat_card", locals: { label: "Human Prompts", value: number_with_delimiter(@total_human_prompts), icon: "user" } %>
  <%= render partial: "stat_card", locals: { label: "Tool Calls", value: number_with_delimiter(@total_tool_calls), icon: "wrench" } %>
  <%= render partial: "stat_card", locals: { label: "Messages", value: number_with_delimiter(@total_messages), icon: "envelope" } %>
  <%= render partial: "stat_card", locals: { label: "Total Tokens", value: format_tokens(@total_tokens), icon: "bolt" } %>
  <%= render partial: "stat_card", locals: { label: "Total Time", value: format_duration(@total_duration_ms), icon: "clock" } %>
</div>

<div class="grid lg:grid-cols-3 gap-6 mb-8">
  <!-- Top tools -->
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <h2 class="text-sm font-medium text-gray-400 mb-4">Top Tools</h2>
    <div class="space-y-2">
      <% max_count = @top_tools.first&.last || 1 %>
      <% @top_tools.each do |name, count| %>
        <div class="flex items-center gap-3">
          <div class="w-24 text-xs text-gray-300 truncate font-mono" title="<%= name %>"><%= name %></div>
          <div class="flex-1 h-5 bg-surface rounded-full overflow-hidden">
            <div class="h-full bg-accent/30 rounded-full" style="width: <%= (count.to_f / max_count * 100).round %>%"></div>
          </div>
          <div class="text-xs text-gray-500 w-12 text-right"><%= number_with_delimiter(count) %></div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Model usage -->
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <h2 class="text-sm font-medium text-gray-400 mb-4">Model Usage</h2>
    <div class="space-y-3">
      <% @model_usage.each do |model, msg_count, total_tokens| %>
        <div class="flex items-center justify-between">
          <div>
            <div class="text-sm text-gray-200 font-mono"><%= model || "unknown" %></div>
            <div class="text-xs text-gray-500"><%= number_with_delimiter(msg_count) %> messages</div>
          </div>
          <div class="text-right">
            <div class="text-sm text-gray-300"><%= format_tokens(total_tokens.to_i) %></div>
            <div class="text-xs text-gray-500">tokens</div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Top projects -->
  <div class="bg-surface-raised border border-border rounded-xl p-5">
    <h2 class="text-sm font-medium text-gray-400 mb-4">Projects</h2>
    <div class="space-y-2">
      <% @projects.each do |path, count| %>
        <%= link_to sessions_path(project: path), class: "flex items-center justify-between group hover:bg-surface-hover -mx-2 px-2 py-1 rounded-lg transition" do %>
          <span class="text-sm text-gray-300 truncate font-mono group-hover:text-white" title="<%= format_project(path) %>"><%= short_project(path) %></span>
          <span class="text-xs text-gray-500 ml-2 shrink-0"><%= count %></span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- Activity chart -->
<div class="bg-surface-raised border border-border rounded-xl p-5 mb-8">
  <h2 class="text-sm font-medium text-gray-400 mb-4">Daily Activity (last 30 days)</h2>
  <div class="flex items-end gap-1 h-32">
    <% max_daily = @daily_sessions.map(&:last).max || 1 %>
    <% @daily_sessions.each do |date, count| %>
      <div class="flex-1 flex flex-col items-center gap-1">
        <div class="w-full bg-accent/40 rounded-t" style="height: <%= (count.to_f / max_daily * 100).round %>%" title="<%= date %>: <%= count %> sessions"></div>
      </div>
    <% end %>
  </div>
  <div class="flex justify-between mt-2 text-[10px] text-gray-600">
    <span><%= @daily_sessions.first&.first %></span>
    <span><%= @daily_sessions.last&.first %></span>
  </div>
</div>

<!-- Recent sessions -->
<div class="bg-surface-raised border border-border rounded-xl">
  <div class="px-5 py-4 border-b border-border flex items-center justify-between">
    <h2 class="text-sm font-medium text-gray-400">Recent Sessions</h2>
    <%= link_to "View all →", sessions_path, class: "text-xs text-accent hover:text-accent-light transition" %>
  </div>
  <div class="divide-y divide-border">
    <% @recent_sessions.each do |session| %>
      <%= link_to session_path(session), class: "block px-5 py-3 hover:bg-surface-hover transition" do %>
        <div class="flex items-center justify-between mb-1">
          <span class="text-sm text-gray-200 truncate mr-4"><%= session.display_title %></span>
          <span class="text-xs text-gray-500 shrink-0"><%= time_ago_short(session.created_at) %></span>
        </div>
        <div class="flex items-center gap-4 text-xs text-gray-500">
          <span class="font-mono"><%= short_project(session.project_path) %></span>
          <% if session.agent_name %>
            <span class="text-accent-light"><%= session.agent_name %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<% content_for(:title) { "SeshQL — #{@session.display_label}" } %>

<!-- Breadcrumb -->
<div class="mb-6">
  <%= link_to "← Sessions", sessions_path, class: "text-sm text-gray-500 hover:text-gray-300 transition" %>
</div>

<!-- Session header -->
<div class="bg-surface-raised border border-border rounded-xl p-5 mb-6">
  <div class="flex items-start justify-between gap-4 mb-4">
    <div>
      <h1 class="text-lg font-semibold text-white mb-1"><%= @session.title %></h1>
      <div class="flex items-center gap-3 text-xs text-gray-500">
        <span class="font-mono"><%= format_project(@session.project_path) %></span>
        <% if @session.agent_name %>
          <span class="px-2 py-0.5 rounded-full bg-accent/20 text-accent-light"><%= @session.agent_name %></span>
        <% end %>
        <% if @session.permission_mode %>
          <span class="px-2 py-0.5 rounded-full bg-yellow-500/20 text-yellow-400"><%= @session.permission_mode %></span>
        <% end %>
      </div>
    </div>
    <div class="text-right text-xs text-gray-500">
      <div><%= @session.created_at&.strftime("%b %-d, %Y %H:%M") %></div>
      <div class="font-mono mt-1"><%= @session.session_id[0..11] %>…</div>
    </div>
  </div>

  <!-- Stats row -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
    <div class="bg-surface rounded-lg px-3 py-2">
      <div class="text-[11px] text-gray-500 uppercase tracking-wide">Cost</div>
      <div class="text-sm font-medium text-emerald-400"><%= format_usd(@session.total_cost_usd) %></div>
    </div>
    <div class="bg-surface rounded-lg px-3 py-2">
      <div class="text-[11px] text-gray-500 uppercase tracking-wide">Active</div>
      <div class="text-sm font-medium text-white"><%= format_duration(@session.active_duration_ms) %></div>
    </div>
    <div class="bg-surface rounded-lg px-3 py-2" title="Wall clock from first to last message">
      <div class="text-[11px] text-gray-500 uppercase tracking-wide">Span</div>
      <div class="text-sm font-medium text-white"><%= format_duration(@session.span_ms) %></div>
    </div>
    <div class="bg-surface rounded-lg px-3 py-2">
      <div class="text-[11px] text-gray-500 uppercase tracking-wide">Your Prompts</div>
      <div class="text-sm font-medium text-white"><%= @session.user_message_count %></div>
    </div>
    <div class="bg-surface rounded-lg px-3 py-2">
      <div class="text-[11px] text-gray-500 uppercase tracking-wide">Claude Turns</div>
      <div class="text-sm font-medium text-white"><%= @session.assistant_message_count %></div>
    </div>
    <div class="bg-surface rounded-lg px-3 py-2" title="<%= token_mix_title(@session) %>">
      <div class="text-[11px] text-gray-500 uppercase tracking-wide">Tokens</div>
      <div class="text-sm font-medium text-white"><%= format_tokens(@session.total_tokens) %></div>
    </div>
  </div>

  <!-- Where the money went -->
  <% if @cost_breakdown.lines.any? %>
    <div class="mt-4">
      <div class="text-[11px] text-gray-500 uppercase tracking-wide mb-2">Cost Breakdown</div>
      <div class="bg-surface rounded-lg divide-y divide-border/60">
        <% @cost_breakdown.lines.each do |line| %>
          <div class="flex items-center gap-3 px-3 py-1.5 text-xs">
            <span class="text-gray-400 w-36 shrink-0"><%= line.label %></span>
            <span class="text-gray-600 font-mono w-20 text-right shrink-0"><%= line.tokens ? format_tokens(line.tokens) : "—" %></span>
            <div class="flex-1 h-1.5 bg-bg/60 rounded-full overflow-hidden min-w-8">
              <div class="h-full bg-emerald-500/50 rounded-full" style="width: <%= line.share.round(1) %>%"></div>
            </div>
            <span class="text-gray-500 w-10 text-right shrink-0"><%= line.share.round %>%</span>
            <span class="text-gray-300 font-mono w-16 text-right shrink-0"><%= format_usd(line.cost_usd) %></span>
          </div>
        <% end %>
      </div>
      <div class="text-[11px] text-gray-600 mt-1.5">
        Estimated from <a href="https://platform.claude.com/docs/en/about-claude/pricing" target="_blank" rel="noopener" class="underline hover:text-gray-400">list prices</a>.
        <% if @cost_breakdown.unpriced_turns.positive? %>
          Excludes <%= @cost_breakdown.unpriced_turns %> turn(s) on an unrecognized model.
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Output: what this session actually produced -->
  <% if @session.pr_links.any? || @session.files_edited_count.positive? || @session.git_commit_count.positive? %>
    <div class="mt-4">
      <div class="text-[11px] text-gray-500 uppercase tracking-wide mb-2">Output</div>
      <div class="flex flex-wrap gap-2">
      <% if @session.files_edited_count.positive? %>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface border border-border text-xs text-gray-400">
          <%= @session.files_edited_count %> <%= "file".pluralize(@session.files_edited_count) %> edited
        </span>
      <% end %>
      <% if @session.git_commit_count.positive? %>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface border border-border text-xs text-gray-400">
          <%= @session.git_commit_count %> git <%= "commit".pluralize(@session.git_commit_count) %>
        </span>
      <% end %>
      <% @session.pr_links.each do |pr| %>
        <a href="<%= pr.pr_url %>" target="_blank" rel="noopener"
           class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-green-400 text-xs hover:bg-green-500/20 transition"
           title="<%= pr.pr_title %>">
          <%= pr_icon("w-3.5 h-3.5 shrink-0") %>
          <span><%= pr.pr_repository %>#<%= pr.pr_number %></span>
          <% if pr.pr_title.present? %>
            <span class="text-green-400/60">— <%= pr.pr_title.truncate(60) %></span>
          <% end %>
        </a>
      <% end %>
      </div>
    </div>
  <% end %>

  <!-- Tool usage -->
  <% if @tool_usage.any? %>
    <div class="mt-4">
      <div class="text-[11px] text-gray-500 uppercase tracking-wide mb-2">Tools Used</div>
      <div class="flex flex-wrap gap-1.5">
        <% @tool_usage.each do |name, count| %>
          <span class="px-2 py-0.5 rounded-full bg-surface text-xs text-gray-400 border border-border">
            <span class="font-mono"><%= name %></span>
            <span class="text-gray-600 ml-1">×<%= count %></span>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Conversation -->
<div class="space-y-3">
  <h2 class="text-sm font-medium text-gray-400 mb-2">Conversation</h2>

  <% @messages.each do |message| %>
    <% case message.message_type %>
    <% when "user_prompt" %>
      <% next unless message.user_prompt %>
      <div class="bg-surface-raised border border-border rounded-xl p-4">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-6 h-6 rounded-full bg-blue-500/20 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0" />
            </svg>
          </div>
          <span class="text-xs font-medium text-blue-400">You</span>
          <span class="text-[11px] text-gray-600 ml-auto"><%= message.timestamp&.strftime("%H:%M:%S") %></span>
        </div>
        <div class="text-sm text-gray-300 whitespace-pre-wrap break-words"><%= message.user_prompt.content_text&.truncate(2000) %></div>
      </div>

    <% when "assistant" %>
      <% next unless message.assistant_message %>
      <% am = message.assistant_message %>
      <div class="bg-surface-raised border border-accent/20 rounded-xl p-4">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-6 h-6 rounded-full bg-accent/20 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-accent-light" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
          </div>
          <span class="text-xs font-medium text-accent-light">Claude</span>
          <span class="text-[11px] text-gray-600 font-mono"><%= am.model %></span>
          <span class="text-[11px] text-gray-600 ml-auto">
            <%= format_tokens(am.total_tokens) %> tokens
          </span>
        </div>

        <% am.content_blocks.order(:position).each do |block| %>
          <% case block.block_type %>
          <% when "text" %>
            <div class="text-sm text-gray-300 whitespace-pre-wrap break-words mb-2"><%= block.text_content&.truncate(3000) %></div>
          <% when "tool_use" %>
            <% tr = @tool_results_by_use_id[block.tool_use_id] %>
            <% tr_content = tr && (tr.result_content.is_a?(Hash) ? (tr.result_content["text"] || tr.result_content.to_json) : tr.result_content.to_s) %>
            <% is_error = tr && tr.result_type.to_s.include?("error") %>
            <div class="my-2 px-3 py-2 bg-surface rounded-lg border <%= is_error ? "border-red-500/40" : "border-border" %>">
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 <%= is_error ? "text-red-500" : "text-yellow-500" %>" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.1 3.03a.75.75 0 01-1.07-.83l1.29-5.81L1.66 7.34a.75.75 0 01.42-1.3l5.92-.5L10.5.67a.75.75 0 011.38 0l2.5 5.07 5.92.5a.75.75 0 01.42 1.3l-4.38 4.22 1.29 5.81a.75.75 0 01-1.07.83l-5.1-3.03z" />
                </svg>
                <span class="text-xs font-mono <%= is_error ? "text-red-400" : "text-yellow-400" %>"><%= block.tool_name %></span>
                <% if block.tool_input.present? && block.tool_input.is_a?(Hash) %>
                  <% first_arg = block.tool_input.values.first %>
                  <span class="text-[11px] text-gray-500 truncate ml-1"><%= first_arg.to_s.truncate(80) %></span>
                <% end %>
                <% if tr.nil? %>
                  <span class="text-[11px] text-gray-600 ml-auto italic">no result</span>
                <% end %>
              </div>
              <% if tr_content.present? %>
                <details class="mt-1.5">
                  <summary class="text-[11px] text-gray-600 cursor-pointer hover:text-gray-400">
                    <%= is_error ? "Error" : "Result" %> (<%= tr_content.length %> chars)
                  </summary>
                  <div class="mt-1 px-2 py-1.5 bg-bg/50 rounded text-xs <%= is_error ? "text-red-300" : "text-gray-500" %> whitespace-pre-wrap break-words max-h-48 overflow-y-auto scrollbar-thin"><%= tr_content.truncate(2000) %></div>
                </details>
              <% end %>
            </div>
          <% when "thinking" %>
            <% encrypted = block.text_content.blank? && block.thinking_signature.present? %>
            <% if encrypted %>
              <div class="my-2 text-[11px] text-gray-600">Thinking (encrypted)</div>
            <% else %>
              <details class="my-2 group">
                <summary class="text-[11px] text-gray-600 cursor-pointer hover:text-gray-400 transition">
                  Thinking (<%= block.text_content&.length || 0 %> chars)
                </summary>
                <div class="mt-1 px-3 py-2 bg-surface rounded-lg text-xs text-gray-500 whitespace-pre-wrap break-words max-h-48 overflow-y-auto scrollbar-thin"><%= block.text_content&.truncate(2000) %></div>
              </details>
            <% end %>
          <% end %>
        <% end %>

        <% if am.stop_reason.present? %>
          <div class="text-[11px] text-gray-600 mt-1">stop: <%= am.stop_reason %></div>
        <% end %>
      </div>

    <% when "tool_result" %>
      <% next %>

    <% when "system" %>
      <% next unless message.system_event %>
      <% se = message.system_event %>
      <div class="flex items-center gap-2 px-4 py-1.5 text-[11px] text-gray-600">
        <div class="flex-1 border-t border-border/50"></div>
        <% if se.subtype == "turn_duration" %>
          <span>Turn completed in <%= format_duration(se.duration_ms) %> (<%= se.message_count %> messages)</span>
        <% else %>
          <span><%= se.subtype %></span>
        <% end %>
        <div class="flex-1 border-t border-border/50"></div>
      </div>
    <% end %>
  <% end %>
</div>

<% content_for(:title) { "SeshQL — Sessions" } %>

<div class="mb-6">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-lg font-semibold text-white">Sessions</h1>
    <div class="text-xs text-gray-500"><%= Session.count %> total</div>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap gap-3 mb-4">
    <%= form_tag sessions_path, method: :get, class: "flex gap-2 flex-1" do %>
      <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search sessions..."
             class="flex-1 bg-surface border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent">
      <% if params[:project].present? %>
        <input type="hidden" name="project" value="<%= params[:project] %>">
      <% end %>
      <% if params[:source].present? %>
        <input type="hidden" name="source" value="<%= params[:source] %>">
      <% end %>
      <button type="submit" class="bg-accent hover:bg-accent-dim text-white text-sm px-4 py-2 rounded-lg transition">Search</button>
    <% end %>
  </div>

  <!-- Agent filter pills -->
  <% if @sources.many? %>
    <div class="flex flex-wrap gap-1.5 mb-3">
      <%= link_to "All agents", sessions_path(project: params[:project], q: params[:q]),
          class: "px-2.5 py-1 rounded-full text-xs transition #{params[:source].blank? ? 'bg-accent text-white' : 'bg-surface border border-border text-gray-400 hover:text-white hover:border-border-light'}" %>
      <% @sources.each do |source| %>
        <%= link_to Sessions::Adapters.for_source(source)&.label || source,
            sessions_path(source: source, project: params[:project], q: params[:q]),
            class: "px-2.5 py-1 rounded-full text-xs transition #{params[:source] == source ? 'bg-accent text-white' : 'bg-surface border border-border text-gray-400 hover:text-white hover:border-border-light'}" %>
      <% end %>
    </div>
  <% end %>

  <!-- Project filter pills -->
  <div class="flex flex-wrap gap-1.5 mb-4">
    <%= link_to "All", sessions_path(q: params[:q], source: params[:source]),
        class: "px-2.5 py-1 rounded-full text-xs transition #{params[:project].blank? ? 'bg-accent text-white' : 'bg-surface border border-border text-gray-400 hover:text-white hover:border-border-light'}" %>
    <% @projects.each do |project| %>
      <%= link_to short_project(project), sessions_path(project: project, q: params[:q], source: params[:source]),
          class: "px-2.5 py-1 rounded-full text-xs font-mono transition #{params[:project] == project ? 'bg-accent text-white' : 'bg-surface border border-border text-gray-400 hover:text-white hover:border-border-light'}" %>
    <% end %>
  </div>
</div>

<!-- Session list -->
<div class="bg-surface-raised border border-border rounded-xl divide-y divide-border">
  <% @sessions.each do |session| %>
    <%= link_to session_path(session), class: "block px-5 py-4 hover:bg-surface-hover transition group" do %>
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <div class="text-sm text-gray-200 group-hover:text-white truncate"><%= session.title %></div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-1 text-xs text-gray-500">
            <span class="font-mono"><%= short_project(session.directory) %></span>
            <span class="px-1.5 py-0.5 rounded bg-white/5 text-gray-400 text-[11px]"><%= session.agent_label %></span>
            <% if session.branch.present? %>
              <span class="font-mono text-gray-600"><%= session.branch %></span>
            <% end %>
            <% if session.worktree %>
              <span class="px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-400 text-[11px]"><%= session.worktree %></span>
            <% end %>
            <% if session.agent_name %>
              <span class="text-accent-light"><%= session.agent_name %></span>
            <% end %>
          </div>
        </div>
        <div class="text-right shrink-0">
          <div class="text-xs text-gray-500"><%= time_ago_short(session.created_at) %></div>
          <div class="text-sm font-medium text-emerald-400/90 mt-0.5" title="Estimated API cost at list prices">
            <%= format_usd(session.total_cost_usd) %>
          </div>
        </div>
      </div>

      <% if session.last_prompt.present? && session.custom_title.present? %>
        <div class="text-xs text-gray-500 truncate mt-1.5"><%= session.last_prompt.truncate(120) %></div>
      <% end %>

      <!-- Stat strip: how long, how much talking, how many tokens, what came out -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-[11px] text-gray-600">
        <span title="Time the agent spent working, and the wall-clock span from first to last message">
          <% if session.active_duration_ms.positive? %>
            <span class="text-gray-400"><%= format_duration(session.active_duration_ms) %></span> active
            <span class="text-gray-700 mx-0.5">·</span>
          <% end %>
          <span class="text-gray-400"><%= format_duration(session.span_ms) %></span> span
        </span>

        <span title="Prompts you sent, and turns the agent took">
          <span class="text-gray-400"><%= session.user_message_count %></span>
          <%= "prompt".pluralize(session.user_message_count) %>
          <span class="text-gray-700 mx-0.5">·</span>
          <span class="text-gray-400"><%= session.assistant_message_count %></span> turns
        </span>

        <span title="<%= token_mix_title(session) %>">
          <span class="text-gray-400"><%= format_tokens(session.total_tokens) %></span> tok
          <span class="text-gray-700 mx-0.5">·</span>
          <span class="text-gray-400"><%= format_tokens(session.total_output_tokens) %></span> out
        </span>

        <% if session.files_edited_count.positive? %>
          <span title="Distinct files touched by Edit/Write">
            <span class="text-gray-400"><%= session.files_edited_count %></span>
            <%= "file".pluralize(session.files_edited_count) %>
          </span>
        <% end %>

        <% if session.git_commit_count.positive? %>
          <span title="git commit invocations">
            <span class="text-gray-400"><%= session.git_commit_count %></span>
            <%= "commit".pluralize(session.git_commit_count) %>
          </span>
        <% end %>

        <% session.pr_links.each do |pr| %>
          <span class="inline-flex items-center gap-1 text-green-400/80" title="<%= pr.pr_url %>">
            <%= pr_icon("w-3 h-3 shrink-0") %>
            <span><%= pr.display_name.truncate(50) %></span>
          </span>
        <% end %>

        <span class="ml-auto font-mono text-gray-700"><%= session.session_id[0..7] %></span>
      </div>
    <% end %>
  <% end %>

  <% if @sessions.empty? %>
    <div class="px-5 py-12 text-center text-gray-500">No sessions found.</div>
  <% end %>
</div>

<!-- Pagination -->
<div class="flex justify-center gap-2 mt-6">
  <% if params[:page].to_i > 1 %>
    <%= link_to "← Previous", sessions_path(page: params[:page].to_i - 1, project: params[:project], q: params[:q]),
        class: "px-4 py-2 bg-surface-raised border border-border rounded-lg text-sm text-gray-400 hover:text-white hover:border-border-light transition" %>
  <% end %>
  <% if @sessions.length == 25 %>
    <%= link_to "Next →", sessions_path(page: (params[:page] || 1).to_i + 1, project: params[:project], q: params[:q]),
        class: "px-4 py-2 bg-surface-raised border border-border rounded-lg text-sm text-gray-400 hover:text-white hover:border-border-light transition" %>
  <% end %>
</div>

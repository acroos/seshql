<%= form_with model: panel, url: (panel.persisted? ? dashboard_panel_path(dashboard, panel) : dashboard_panels_path(dashboard)), class: "" do |f| %>
  <% if panel.errors.any? %>
    <div class="bg-red-950/50 border border-red-800/50 rounded-xl px-5 py-4 mb-6">
      <p class="text-sm text-red-400"><%= panel.errors.full_messages.join(", ") %></p>
    </div>
  <% end %>

  <div class="grid lg:grid-cols-4 gap-4">
    <!-- Main form -->
    <div class="lg:col-span-3 space-y-4">
      <div class="bg-surface-raised border border-border rounded-xl p-5 space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs text-gray-500 mb-1.5">Panel Title</label>
            <%= f.text_field :title, autofocus: true, placeholder: "e.g. Token Usage by Command",
                class: "w-full bg-surface border border-border rounded-lg px-3 py-2 text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-accent" %>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1.5">Chart Type</label>
            <%= f.select :chart_type, [["Bar", "bar"], ["Stacked Bar", "stacked_bar"], ["Line", "line"]],
                {}, class: "w-full bg-surface border border-border rounded-lg px-3 py-2 text-sm text-gray-200 focus:outline-none focus:border-accent" %>
          </div>
        </div>

        <div>
          <label class="block text-xs text-gray-500 mb-1.5">SQL Query</label>
          <textarea name="dashboard_panel[sql_query]" rows="12" spellcheck="false" wrap="off"
                    placeholder="SELECT ..."
                    class="w-full bg-surface border border-border rounded-lg px-3 py-3 text-sm text-gray-200 font-mono leading-relaxed placeholder-gray-600 focus:outline-none focus:border-accent resize-y overflow-x-auto"
                    style="min-height: 140px;"><%= panel.sql_query %></textarea>
          <p class="text-xs text-gray-600 mt-1.5">Only SELECT queries allowed. Max 500 rows.</p>
        </div>
      </div>

      <!-- Column mapping -->
      <div class="bg-surface-raised border border-border rounded-xl p-5">
        <h3 class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-3">Column Mapping</h3>
        <p class="text-xs text-gray-600 mb-4">
          <strong class="text-gray-500">Wide format:</strong> Set only X Column. Each remaining numeric column becomes a series.<br>
          <strong class="text-gray-500">Pivot format:</strong> Set all three. Series Column values become separate lines/bars, Value Column provides the numbers.
        </p>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-xs text-gray-500 mb-1.5">X Column <span class="text-gray-600">(labels)</span></label>
            <%= f.text_field :x_column, placeholder: "e.g. session_label",
                class: "w-full bg-surface border border-border rounded-lg px-3 py-2 text-sm text-gray-200 font-mono placeholder-gray-600 focus:outline-none focus:border-accent" %>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1.5">Series Column <span class="text-gray-600">(optional)</span></label>
            <%= f.text_field :series_column, placeholder: "e.g. command",
                class: "w-full bg-surface border border-border rounded-lg px-3 py-2 text-sm text-gray-200 font-mono placeholder-gray-600 focus:outline-none focus:border-accent" %>
          </div>
          <div>
            <label class="block text-xs text-gray-500 mb-1.5">Value Column <span class="text-gray-600">(if pivot)</span></label>
            <%= f.text_field :value_column, placeholder: "e.g. total_tokens",
                class: "w-full bg-surface border border-border rounded-lg px-3 py-2 text-sm text-gray-200 font-mono placeholder-gray-600 focus:outline-none focus:border-accent" %>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <%= f.submit panel.persisted? ? "Update Panel" : "Add Panel",
            class: "bg-accent hover:bg-accent-dim text-white text-sm font-medium px-5 py-2 rounded-lg transition cursor-pointer" %>
        <%= link_to "Cancel", dashboard_path(dashboard), class: "text-sm text-gray-500 hover:text-gray-300 transition" %>
      </div>
    </div>

    <!-- Schema reference -->
    <div class="lg:col-span-1">
      <div class="bg-surface-raised border border-border rounded-xl p-4 max-h-[600px] overflow-y-auto scrollbar-thin sticky top-4">
        <h2 class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-3">Schema Reference</h2>
        <% schema.each do |table, columns| %>
          <details class="mb-2 group">
            <summary class="cursor-pointer text-sm text-accent-light hover:text-white transition flex items-center gap-1">
              <svg class="w-3 h-3 text-gray-500 group-open:rotate-90 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
              <%= table %>
            </summary>
            <div class="ml-4 mt-1 space-y-0.5">
              <% columns.each do |col| %>
                <div class="text-xs text-gray-500 font-mono"><%= col %></div>
              <% end %>
            </div>
          </details>
        <% end %>

        <div class="mt-4 pt-3 border-t border-border">
          <h3 class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-2">Key Joins</h3>
          <div class="text-xs text-gray-500 space-y-1 font-mono leading-relaxed">
            <p>messages.session_id = sessions.session_id</p>
            <p>assistant_messages.message_uuid = messages.uuid</p>
            <p>content_blocks.assistant_message_uuid = assistant_messages.message_uuid</p>
            <p>user_prompts.message_uuid = messages.uuid</p>
            <p>tool_results.message_uuid = messages.uuid</p>
            <p>system_events.message_uuid = messages.uuid</p>
            <p>pr_links.session_id = sessions.session_id</p>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-border">
          <h3 class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-2">Example: Tokens by Command</h3>
          <pre class="text-[10px] text-gray-600 font-mono whitespace-pre-wrap leading-relaxed">WITH top_cmds AS (
  SELECT SPLIT_PART(
    cb.tool_input->>'command',
    ' ', 1) AS cmd
  FROM content_blocks cb
  WHERE cb.block_type = 'tool_use'
    AND cb.tool_name = 'Bash'
  GROUP BY cmd
  ORDER BY COUNT(*) DESC
  LIMIT 5
)
SELECT
  COALESCE(s.custom_title,
    LEFT(s.last_prompt, 30))
    AS session_label,
  tc.cmd AS command,
  COALESCE(SUM(
    am.input_tokens
    + am.output_tokens
    + am.cache_creation_input_tokens
    + am.cache_read_input_tokens
  ), 0) AS total_tokens
FROM top_cmds tc
JOIN content_blocks cb
  ON SPLIT_PART(
    cb.tool_input->>'command',
    ' ', 1) = tc.cmd
  AND cb.block_type = 'tool_use'
  AND cb.tool_name = 'Bash'
JOIN assistant_messages am
  ON am.message_uuid
    = cb.assistant_message_uuid
JOIN messages m
  ON am.message_uuid = m.uuid
JOIN sessions s
  ON m.session_id = s.session_id
GROUP BY s.session_id,
  s.custom_title,
  s.last_prompt, tc.cmd
ORDER BY session_label</pre>
          <p class="text-[10px] text-gray-600 mt-2">
            X: <code class="text-gray-500">session_label</code><br>
            Series: <code class="text-gray-500">command</code><br>
            Value: <code class="text-gray-500">total_tokens</code>
          </p>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
function initPanelTextarea() {
  const ta = document.querySelector('textarea[name="dashboard_panel[sql_query]"]');
  if (!ta || ta.dataset.enhanced) return;
  ta.dataset.enhanced = 'true';
  ta.addEventListener('keydown', function(e) {
    if (e.key === 'Tab') {
      e.preventDefault();
      const start = this.selectionStart;
      const end = this.selectionEnd;
      this.value = this.value.substring(0, start) + '  ' + this.value.substring(end);
      this.selectionStart = this.selectionEnd = start + 2;
    }
  });
}
initPanelTextarea();
document.addEventListener('turbo:load', initPanelTextarea);
document.addEventListener('turbo:render', initPanelTextarea);
</script>

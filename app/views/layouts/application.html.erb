<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "SeshQL" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              surface: { DEFAULT: '#0f1117', raised: '#1a1d27', hover: '#242837' },
              border: { DEFAULT: '#2a2e3d', light: '#363b4e' },
              accent: { DEFAULT: '#6366f1', light: '#818cf8', dim: '#4f46e5' },
            }
          }
        }
      }
    </script>
    <style>
      body { font-feature-settings: "cv02", "cv03", "cv04", "cv11"; }
      .scrollbar-thin::-webkit-scrollbar { width: 6px; }
      .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
      .scrollbar-thin::-webkit-scrollbar-thumb { background: #2a2e3d; border-radius: 3px; }
    </style>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-surface text-gray-200 dark antialiased">
    <div class="min-h-full">
      <nav class="border-b border-border bg-surface-raised">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex h-14 items-center justify-between">
            <div class="flex items-center gap-6">
              <%= link_to root_path, class: "flex items-center gap-2 text-white font-semibold text-lg" do %>
                <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                </svg>
                SeshQL
              <% end %>
              <div class="flex items-center gap-1">
                <%= link_to "Dashboards", dashboards_path, class: "px-3 py-1.5 rounded-md text-sm #{request.path.start_with?('/dashboards') || request.path == '/' ? 'bg-surface text-white' : 'text-gray-400 hover:text-white hover:bg-surface-hover'} transition" %>
                <%= link_to "Sessions", sessions_path, class: "px-3 py-1.5 rounded-md text-sm #{request.path.start_with?('/sessions') ? 'bg-surface text-white' : 'text-gray-400 hover:text-white hover:bg-surface-hover'} transition" %>
                <%= link_to "SQL Console", sql_console_index_path, class: "px-3 py-1.5 rounded-md text-sm #{request.path.start_with?('/sql_console') ? 'bg-surface text-white' : 'text-gray-400 hover:text-white hover:bg-surface-hover'} transition" %>
              </div>
            </div>
            <div class="flex items-center gap-3 text-xs text-gray-500">
              <span><%= Session.count %> sessions &middot; <%= number_with_delimiter(Message.count) %> messages</span>
              <% recent_failures = IngestionRun.failures.where("run_at > ?", 24.hours.ago).count %>
              <%= link_to ingestion_runs_path, class: "flex items-center gap-1.5 px-2 py-1 rounded #{recent_failures.positive? ? 'text-red-400 hover:bg-red-950/40' : 'text-gray-500 hover:bg-surface-hover'} transition", title: "Ingestion runs" do %>
                <span class="<%= recent_failures.positive? ? 'bg-red-500' : 'bg-green-500' %> w-1.5 h-1.5 rounded-full"></span>
                <span>ingest<%= recent_failures.positive? ? " (#{recent_failures})" : "" %></span>
              <% end %>
            </div>
          </div>
        </div>
      </nav>

      <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
        <%= yield %>
      </main>
    </div>
  </body>
</html>

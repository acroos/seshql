#!/usr/bin/env ruby
require_relative "../config/environment"
require "listen"

roots = Sessions::Adapters.enabled.flat_map(&:existing_roots).uniq
abort "[watch] no agent session directories found" if roots.empty?

# Codex compresses older rollouts, so both extensions have to be watched.
listener = Listen.to(*roots, only: /\.jsonl(\.zst)?$/, wait_for_delay: 0.5) do |modified, added, _removed|
  paths = (modified + added).uniq
  next if paths.empty?

  Rails.application.executor.wrap do
    paths.each { |path| IngestSessionFileJob.perform_later(path) }
  end
  Rails.logger.info("[watch] enqueued #{paths.size}")
end

listener.start
puts "[watch] watching #{roots.join(', ')}"
sleep
